{
  "expo": {
    "name": "CalPT",
    "slug": "calpt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calpt",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F7F4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "pt.calpt.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Precisamos da câmara para analisar as tuas refeições.",
        "NSPhotoLibraryUsageDescription": "Precisamos de acesso às fotos para analisar as tuas refeições.",
        "NSHealthShareUsageDescription": "Sincroniza calorias com o Apple Health.",
        "NSHealthUpdateUsageDescription": "Escreve calorias no Apple Health."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F8F7F4"
      },
      "package": "pt.calpt.app",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Precisamos da câmara para analisar as tuas refeições."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "calpt-placeholder"
      }
    }
  }
}
